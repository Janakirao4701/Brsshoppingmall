import createMiddleware from 'next-intl/middleware';
import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/request';
import { routing } from './i18n/routing';

// Initialize the next-intl middleware
const intlMiddleware = createMiddleware(routing);

// Simple in-memory rate limiting (Note: In production with multiple instances, 
// a KV store like Redis/Upstash is recommended)
const rateLimitMap = new Map<string, { count: number; lastReset: number }>();
const RATE_LIMIT = 100; // requests
const RATE_LIMIT_WINDOW = 60 * 1000; // 1 minute

export default function middleware(request: NextRequest) {
  const ip = request.ip || 'anonymous';
  const { pathname } = request.nextUrl;

  // 1. Layer 7 Rate Limiting for API routes
  if (pathname.startsWith('/api')) {
    const now = Date.now();
    const userLimit = rateLimitMap.get(ip) || { count: 0, lastReset: now };

    if (now - userLimit.lastReset > RATE_LIMIT_WINDOW) {
      userLimit.count = 0;
      userLimit.lastReset = now;
    }

    userLimit.count++;
    rateLimitMap.set(ip, userLimit);

    if (userLimit.count > RATE_LIMIT) {
      return new NextResponse('Too Many Requests', {
        status: 429,
        headers: {
          'Content-Type': 'text/plain',
          'Retry-After': '60',
        },
      });
    }
  }

  // 2. Apply next-intl middleware for all routes
  const response = intlMiddleware(request);

  // 3. Ensure essential security headers are present (Backup for next.config.ts)
  response.headers.set('X-Frame-Options', 'SAMEORIGIN');
  response.headers.set('X-Content-Type-Options', 'nosniff');
  response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');

  return response;
}

export const config = {
  // Match all pathnames except for
  // - /api (handled manually above for rate limiting)
  // - /_next (Next.js internals)
  // - /_vercel (Vercel internals)
  // - /static (static files)
  // - all root files (e.g. /favicon.ico)
  matcher: ['/((?!_next|_vercel|static|.*\\..*).*)']
};
